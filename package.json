{
  "name": "raycast-scripts",
  "version": "1.0.0",
  "description": "TypeScript Raycast scripts",
  "scripts": {
    "build": "tsc && node public/flatten.js && npm run make-executable",
    "make-executable": "find dist -name '*.js' -exec chmod +x {} \\;",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}